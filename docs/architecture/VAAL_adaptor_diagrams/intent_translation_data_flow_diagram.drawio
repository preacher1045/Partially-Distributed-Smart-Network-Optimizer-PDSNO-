                </mxCell>
                <mxCell id="14" value="if intent_type == CREATE_VLAN:&lt;div&gt;    return _translate_vlan(parameters)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;def _translate_vlan(params):&lt;/div&gt;&lt;div&gt;    commands = []&lt;/div&gt;&lt;div&gt;    commands.append(f&#39;vlan {params[\&#39;vlan_id\&#39;]}&#39;)&lt;/div&gt;&lt;div&gt;    commands.append(f&#39;name {params[\&#39;name\&#39;]}&#39;)&lt;/div&gt;&lt;div&gt;    if params.get(\&#39;description\&#39;):&lt;/div&gt;&lt;div&gt;        commands.append(f&#39;! {params[\&#39;description\&#39;]}&#39;)&lt;/div&gt;&lt;div&gt;    commands.append(&#39;exit&#39;)&lt;/div&gt;&lt;div&gt;    return commands&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
